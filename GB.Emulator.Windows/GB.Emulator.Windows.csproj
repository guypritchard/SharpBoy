<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GB.Emulator.Core\GB.Emulator.Core.csproj" />
    <ProjectReference Include="..\GB.Emulator.Hosting\GB.Emulator.Hosting.csproj" />
    <ProjectReference Include="..\GB.Emulator.Core.Win32\GB.Emulator.Core.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GB.Emulator.Windows.Tests" />
    <None Update="Desktop/Assets/Dmg.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Desktop/Assets/ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GB.Roms\SPRITE.GB" Link="SPRITE.GB" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
